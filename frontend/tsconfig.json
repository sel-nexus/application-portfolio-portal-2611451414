{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true, "noEmit": true,
    "forceConsistentCasingInFileNames": true, "esModuleInterop": true, "jsx": "react-jsx",
    "noUnusedLocals": false, "noUnusedParameters": false, "resolveJsonModule": true
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts", "playwright.config.ts", "e2e"]
}
