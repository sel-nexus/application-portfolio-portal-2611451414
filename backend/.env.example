# Mongo server only; select the database separately.
MONGODB_URI=mongodb://127.0.0.1:27017
# Persistent application database.
MONGODB_DB=portfolio_portal
# Replace with a randomly generated secret before starting the API.
JWT_SECRET=dev-secret-change-in-production
# Comma-separated browser origins; optional behind same-origin nginx.
CORS_ORIGINS=http://localhost:5173
# Enable the public demo baseline only in demonstration environments.
SEED_ON_STARTUP=true
