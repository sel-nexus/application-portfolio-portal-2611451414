# Same-origin browser API by default; a relative prefix is supported.
VITE_API_BASE_URL=/
# Development server proxy target; never bundled into browser code.
API_PROXY_TARGET=http://127.0.0.1:8000
# Browser verification origin and dedicated persistent test database.
E2E_BASE_URL=http://127.0.0.1:5173
E2E_API_URL=http://127.0.0.1:8000
E2E_MONGODB_DB=portal_e2e
# Use a private generated signing key when running browser tests.
E2E_JWT_SECRET=dev-secret-change-in-production
